# The .vsix ships only the VS Code theme JSONs, the icon, and the README.
# The README's hero image is loaded from an absolute GitHub raw URL, so the
# screenshots/ folder does not need to be packaged.

# Palette source of truth (build-time only)
scripts/

# Terminal & editor ports — each has its own install path, not the extension
ghostty/
iterm/
sublime-text/
vim/
warp/
windows-terminal/

# Repo / dev files
test/
.git/
# Agent worktrees. vsce never reads .gitignore, and these are ignored here only
# by a machine-local global gitignore — so without this an agent scratch tree
# present at publish time ships a second copy of the whole repo to users.
.worktrees/
.claude/
.gitignore
.github/
CLAUDE.md
CONTRIBUTING.md
CHANGELOG.md
screenshots/
node_modules/
*.vsix
.DS_Store
Thumbs.db
