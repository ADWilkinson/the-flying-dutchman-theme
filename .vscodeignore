# The .vsix ships only the VS Code theme JSONs, the icon, and the README.
# The README's hero image is loaded from an absolute GitHub raw URL, so the
# screenshots/ folder does not need to be packaged.

# Palette source of truth (build-time only)
scripts/

# Terminal & editor ports — each has its own install path, not the extension
ghostty/
iterm/
sublime-text/
vim/
warp/
windows-terminal/

# Repo / dev files
test/
.git/
.gitignore
.github/
CLAUDE.md
CONTRIBUTING.md
CHANGELOG.md
screenshots/
node_modules/
*.vsix
.DS_Store
Thumbs.db
