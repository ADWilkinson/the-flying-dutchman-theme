  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#738391",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#7cb6a0"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#d3c088"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#d3c088"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d3c088"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8daec4"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.section",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#8f9ba8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7ab9bd"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.namespace",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#c8ae7e"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "#bec8d5"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#bec8d5"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#d3a297",
        "fontStyle": "italic"
      }
