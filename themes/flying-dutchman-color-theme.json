  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a7b8a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#65bd9c"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#e0c471"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#e0c471"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#e0c471"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#75acd1"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.section",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#8a98a8"
      }
    },
    {
      "scope": [
